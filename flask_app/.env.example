# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Core
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://imagehost:password@localhost:5432/imagehost

# Branding / white-label
APP_NAME=ADM CLAUDE
APP_BASE_URL=http://localhost:5000
APP_LOGO_URL=/static/images/adm-cloud-logo.svg
APP_FAVICON_URL=/static/images/adm-cloud-logo.svg
APP_PRIMARY_COLOR=#0d73ff
APP_SECONDARY_COLOR=#7c4dff
SUPPORT_EMAIL=support@example.com
# Optional: dedicated image domain that proxies to this app's /i/ route
PUBLIC_IMAGE_BASE_URL=

# Optional social login providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Image storage provider (server-side only, never exposed to the browser)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=uploads
CLOUDINARY_THUMB_TRANSFORM=c_fill,w_400,h_400,q_auto,f_auto

# Email delivery (SendGrid recommended for Render - works on free tier)
# Get free SendGrid API key: https://sendgrid.com/free
SENDGRID_API_KEY=SG.xxx...
SMTP_FROM_EMAIL=noreply@example.com

# (Optional) SMTP for local testing with Gmail
# Note: Gmail SMTP is blocked on Render free tier
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15

# Uploads
UPLOAD_MAX_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Sessions / security
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=604800
VERIFICATION_TOKEN_MAX_AGE=86400

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_LOGIN=10 per 15 minutes
RATELIMIT_REGISTER=5 per hour
RATELIMIT_VERIFY_RESEND=5 per hour
RATELIMIT_UPLOAD=60 per hour
